FROM golang:latest AS builder

WORKDIR /go-modules

COPY . ./

# Building using -mod=vendor, which will utilize the vendor directory
RUN CGO_ENABLED=0 GOOS=linux go build -v -mod=vendor -o aggregate ttnmapper-services/cmd/aggregate

FROM scratch
WORKDIR /root/

COPY --from=builder /go-modules/aggregate .

CMD ["./aggregate"]
